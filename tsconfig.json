{
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true, "strict": true, "noImplicitAny": false,
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"], "skipLibCheck": true
  },
  "include": ["src/core/**/*.js", "src/boot/**/*.js", "tools/*.mjs"]
}
