{
  "name": "ponto-cego",
  "version": "6.0.0-beta.9",
  "private": false,
  "description": "Ponto Cego: FPS tático 5v5 no navegador (Babylon.js), com bots e modo online.",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:test": "node tools/build.mjs --test",
    "typecheck": "tsc -p tsconfig.json",
    "test:sim": "node test/qa.js 40",
    "test:browser": "node test/qa-browser.js",
    "test:net": "node test/net.js",
    "win": "node tools/build-win.mjs",
    "test:server": "node test/mp_server.js"
  },
  "dependencies": {
    "@babylonjs/havok": "1.3.14",
    "babylonjs": "9.29.0",
    "babylonjs-gui": "9.29.0",
    "babylonjs-loaders": "9.29.0",
    "meshoptimizer": "0.22.0"
  },
  "devDependencies": {
    "@electron/packager": "18.4.4",
    "@types/node": "^22.18.8",
    "electron": "38.2.0",
    "esbuild": "0.25.10",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "author": "Felipe Neves Lopes Diniz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lipefp/ponto-cego.git"
  }
}
